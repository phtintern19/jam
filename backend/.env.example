# Database Configuration
# For MySQL: Update MYSQL_ROOT_PASSWORD with your MySQL root password
MYSQL_ROOT_PASSWORD=root
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bidzone

# For SQLite (alternative - no MySQL required):
# Uncomment the line below to use SQLite instead of MySQL
USE_SQLITE=false

# Connection Pool Settings
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=45
DB_POOL_RECYCLE=3600

# Flask Configuration
FLASK_APP=main.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
