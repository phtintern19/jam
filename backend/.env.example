# =============================================================================
# JamRig / BidZone — cPanel + Passenger environment template
# Copy to backend/.env and fill in values from cPanel → MySQL Databases / Email
# Application root should point at the backend/ folder (where passenger_wsgi.py lives)
# =============================================================================

# --- Database (cPanel MySQL) ---
USE_SQLITE=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_dbname
DB_PASSWORD=your_mysql_password
DB_NAME=cpaneluser_dbname

# Conservative pools for shared hosting (raise only if your plan allows)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=280

# --- Flask / Security ---
FLASK_ENV=production
FLASK_APP=app.py
SECRET_KEY=change-this-to-a-long-random-string
# Set true when site is served over HTTPS (typical on cPanel)
SESSION_COOKIE_SECURE=true
USE_PROXY_FIX=true

# Your public site URL (or *). Comma-separate multiple origins if needed.
FRONTEND_URL=*

# --- Auction engine (Passenger) ---
# Request-scoped ticks always run. Background thread is optional (often killed on idle).
ENABLE_AUCTION_ENGINE_THREAD=false
AUCTION_TICK_INTERVAL=5

# --- Setup helpers (KEEP false in production) ---
ENABLE_SETUP_ROUTES=false

# --- Email (OTP / password reset) — use cPanel email or Gmail app password ---
SMTP_SERVER=mail.yourdomain.com
SMTP_PORT=587
SMTP_EMAIL=noreply@yourdomain.com
SMTP_PASSWORD=your_email_password

# --- Optional ---
# HOST=0.0.0.0
# PORT=8000
# MAX_CONTENT_LENGTH=6291456
